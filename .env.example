# MLOps Project Environment Variables
# Copy this file to .env and fill in your values.

# GitHub username used for experiment tracking (MLflow runs)
GITHUB_USERNAME=

# MLflow tracking URI (default: file://./efs/mlflow)
# MLFLOW_TRACKING_URI=file://./efs/mlflow

# Shared storage directory for models and artifacts (default: ./efs)
# EFS_DIR=./efs

# Random seed for reproducibility (default: 42)
# SEED=42
